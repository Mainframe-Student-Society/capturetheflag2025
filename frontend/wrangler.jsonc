{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "mass-ctf",
	"compatibility_date": "2025-03-25",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"preview_urls": false,
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "mass-ctf.razeev-dev.workers.dev\n"
	}
}